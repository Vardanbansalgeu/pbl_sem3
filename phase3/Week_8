// Week 8: read individual bits from a stream (most-significant bit first).
class BitReader {
    ifstream& input;
    unsigned char buffer;
    int bitsAvailable;
    bool ok;
public:
    explicit BitReader(ifstream& in)
        : input(in), buffer(0), bitsAvailable(0), ok(true) {}

    int readBit() {
        if (bitsAvailable == 0) {
            char ch;
            input.get(ch);
            if (!input) {
                ok = false;
                return -1;
            }
            buffer = static_cast<unsigned char>(ch);
            bitsAvailable = 8;
        }
        int bit = (buffer >> 7) & 1;
        buffer = static_cast<unsigned char>(buffer << 1);
        --bitsAvailable;
        return bit;
    }

    bool good() const {
        return ok && static_cast<bool>(input);
    }
};

// Weeks 8-9: read the SmartFile header back.
bool readSmartFileHeader(ifstream& in, int& mode, uint64_t& originalSize,
                         unsigned long long frequency[256]) {
    char magic[6];
    in.read(magic, 6);
    if (!in) return false;
    for (int i = 0; i < 6; ++i)
        if (magic[i] != "SFILE1"[i]) return false;

    char modeByte;
    in.get(modeByte);
    if (!in) return false;
    mode = static_cast<unsigned char>(modeByte);

    originalSize = 0;
    for (int i = 0; i < 8; ++i) {
        char b;
        in.get(b);
        if (!in) return false;
        originalSize |= static_cast<uint64_t>(static_cast<unsigned char>(b)) << (8 * i);
    }

    for (int i = 0; i < 256; ++i) {
        uint64_t val = 0;
        for (int j = 0; j < 8; ++j) {
            char b;
            in.get(b);
            if (!in) return false;
            val |= static_cast<uint64_t>(static_cast<unsigned char>(b)) << (8 * j);
        }
        frequency[i] = static_cast<unsigned long long>(val);
    }
    return true;
}
