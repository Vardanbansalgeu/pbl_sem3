// Week 8: read individual bits from a stream (most-significant bit first).
class BitReader {
    ifstream& input;
    unsigned char buffer;
    int bitsAvailable;
    bool ok;
public:
    explicit BitReader(ifstream& in)
        : input(in), buffer(0), bitsAvailable(0), ok(true) {}

    int readBit() {
        if (bitsAvailable == 0) {
            char ch;
            input.get(ch);
            if (!input) {
                ok = false;
                return -1;
            }
            buffer = static_cast<unsigned char>(ch);
            bitsAvailable = 8;
        }
        int bit = (buffer >> 7) & 1;
        buffer = static_cast<unsigned char>(buffer << 1);
        --bitsAvailable;
        return bit;
    }

    bool good() const {
        return ok && static_cast<bool>(input);
    }
};

// Weeks 8-9: read the SmartFile header back.
bool readSmartFileHeader(ifstream& in, int& mode, uint64_t& originalSize,
                         unsigned long long frequency[256]) {
    char magic[6];
    in.read(magic, 6);
    if (!in) return false;
    for (int i = 0; i < 6; ++i)
        if (magic[i] != "SFILE1"[i]) return false;

    char modeByte;
    in.get(modeByte);
    if (!in) return false;
    mode = static_cast<unsigned char>(modeByte);

    originalSize = 0;
    for (int i = 0; i < 8; ++i) {
        char b;
        in.get(b);
        if (!in) return false;
        originalSize |= static_cast<uint64_t>(static_cast<unsigned char>(b)) << (8 * i);
    }

    for (int i = 0; i < 256; ++i) {
        uint64_t val = 0;
        for (int j = 0; j < 8; ++j) {
            char b;
            in.get(b);
            if (!in) return false;
            val |= static_cast<uint64_t>(static_cast<unsigned char>(b)) << (8 * j);
        }
        frequency[i] = static_cast<unsigned long long>(val);
    }
    return true;
}

// Weeks 8-9: decode a .sfile back to the original data (Huffman or RAW).
bool decompressFile(const string& inputName, const string& outputName) {
    ifstream input(inputName.c_str(), ios::binary);
    if (!input) {
        cout << "Cannot open input file!\n";
        return false;
    }

    int mode = 0;
    uint64_t originalSize = 0;
    unsigned long long frequency[256] = {0};

    if (!readSmartFileHeader(input, mode, originalSize, frequency)) {
        cout << "Invalid or corrupted .sfile header!\n";
        return false;
    }

    ofstream output(outputName.c_str(), ios::binary | ios::trunc);
    if (!output) {
        cout << "Cannot create output file!\n";
        return false;
    }

    bool ok = true;

    if (mode == 2) {
        // Week 9: RAW mode — copy original bytes directly.
        char ch;
        uint64_t copied = 0;
        while (copied < originalSize && input.get(ch)) {
            output.put(ch);
            ++copied;
        }
        if (copied < originalSize) ok = false;
    } else if (mode == 1) {
        // Week 8: Huffman mode — rebuild tree and decode bits.
        HuffmanNode* root = buildHuffmanTree(frequency);

        if (root == nullptr) {
            ok = true; // empty file
        } else {
            BitReader reader(input);
            uint64_t decoded = 0;
            while (decoded < originalSize && reader.good()) {
                HuffmanNode* node = root;
                if (node->left == nullptr && node->right == nullptr) {
                    output.put(static_cast<char>(node->data));
                    ++decoded;
                    continue;
                }
                while (node->left != nullptr || node->right != nullptr) {
                    int bit = reader.readBit();
                    if (bit < 0) { ok = false; break; }
                    node = (bit == 0) ? node->left : node->right;
                    if (node == nullptr) { ok = false; break; }
                }
                if (!ok) break;
                output.put(static_cast<char>(node->data));
                ++decoded;
            }
            if (decoded < originalSize) ok = false;
            deleteTree(root);
        }
    } else {
        cout << "Unknown mode in .sfile!\n";
        ok = false;
    }

    output.close();
    if (!ok || output.fail()) {
        cout << "Decompression failed (read/write error).\n";
        return false;
    }

    cout << "Decompression completed!\n";
    cout << "Output: " << outputName << "\n";
    cout << "Original size: " << originalSize << " bytes\n";
    cout << "Mode: " << (mode == 1 ? "HUFFMAN" : (mode == 2 ? "RAW" : "UNKNOWN")) << "\n";
    return true;
}
